# ─────────────────────────────── Base de datos local
# SQLite se usa sólo para correr los tests rápido (ver 02_Documento_Tecnico §4.1).
*.db
*.sqlite
*.sqlite3
dev.db
test.db

# ─────────────────────────────── Node y Tailwind
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# CSS compilado por Tailwind: se genera en el build, no se versiona.
web/public/app.css
web/public/app.css.map

# ─────────────────────────────── Consultas con datos reales
# `scripts/consultas_usuario.sql` lleva el uuid de una cuenta de verdad
# escrito adentro. No es una credencial —no da acceso a nada—, pero es
# el identificador de una persona y no tiene por qué estar acá.
# Se versionó por accidente en F17-T06, con un `git add -A`.
scripts/consultas_usuario.sql

