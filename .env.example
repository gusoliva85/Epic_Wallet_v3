# ============================================================
#  EPIC WALLET 3.0 · variables de entorno
#
#  Copiar a .env y completar:   cp .env.example .env
#  .env NUNCA se versiona (está en .gitignore). Este archivo sí.
#
#  Verificar que todo quedó bien:  python scripts/check_db.py
#  Referencia: documentacion/02_Documento_Tecnico.md §11
# ============================================================


# ------------------------------------------------------------
#  BASE DE DATOS · Postgres propio, un solo esquema
# ------------------------------------------------------------
# La contraseña de Postgres. El compose la exige: sin ella no
# levanta, en lugar de levantar con una por defecto.
POSTGRES_PASSWORD=
POSTGRES_USER=epic
POSTGRES_DB=epic_wallet

# Cadena de conexión de la API. El host es `db`, que es el nombre
# del contenedor de la base en la red interna del compose; desde
# afuera no se la alcanza, porque no publica ningún puerto.
#
# El prefijo va con el driver: postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://epic:CONTRASENA@db:5432/epic_wallet

# Esquema de Postgres donde viven las tablas. Un solo esquema para
# todo el proyecto (02_Documento_Tecnico §4.1.1): siempre 'public',
# en tu máquina también. No tiene valor por defecto a propósito
# (migrations/env.py lo exige): migrar es la operación destructiva
# del proyecto, y que pida ser explícito es deliberado. Para migrar
# de verdad hay que pasar además APP_ENV=production en la línea de
# comando, aunque el resto del trabajo local use "development".
DB_SCHEMA=public

# Alternativa sólo para los tests de cálculo, sin base:
# DATABASE_URL=sqlite+pysqlite:///./test.db
# DB_SCHEMA=main

# ------------------------------------------------------------
#  LA BASE DE LAS PRUEBAS
# ------------------------------------------------------------
# `tests/api/` corre contra ESTA base, no contra la de arriba, y le
# borra filas sin preguntar. Tiene que ser una base dedicada y su
# nombre tiene que contener «test» o «prueba»: si no, las pruebas se
# niegan a arrancar.
#
# No tiene valor por defecto a propósito. Si cayera en `DATABASE_URL`,
# un `pytest` distraído le borraría filas a la base de trabajo.
#
# Para levantarla:
#   docker compose -f docker-compose.yml -f docker-compose.desarrollo.yml up -d db
#   docker compose exec db createdb -U epic epic_wallet_test
#
# El esquema lo crea sola la primera corrida de `pytest`.
TEST_DATABASE_URL=postgresql+psycopg://epic:CONTRASENA@localhost:5432/epic_wallet_test


# ------------------------------------------------------------
#  FIRMA DE LAS SESIONES
# ------------------------------------------------------------
# Par de claves ES256 del proyecto. Se generan con
#
#     python scripts/generar_claves.py
#
# y se pegan acá tal como las imprime, en una sola línea cada una.
#
# La PRIVADA permite fabricar la sesión de cualquier usuario, sin
# contraseña y sin dejar rastro. No entra al repositorio, no va al
# frontend y no sale del servidor.
# >>> SECRETA.
JWT_PRIVATE_KEY=

# La PÚBLICA sólo verifica. No es un secreto.
JWT_PUBLIC_KEY=


# ------------------------------------------------------------
#  SUPABASE · en retirada
# ------------------------------------------------------------
# TODO ESTE BLOQUE DESAPARECE EN F17, con la autenticación propia.
# En el servidor va vacío: la aplicación levanta y se ve, pero nadie
# puede iniciar sesión hasta que F17 esté hecha. Se deja acá para que
# la máquina de desarrollo pueda seguir trabajando mientras tanto.
#
# URL del proyecto. Panel → Project Settings → Data API.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clave PÚBLICA. En el panel aparece como "anon public" o, en
# proyectos nuevos, como "Publishable key".
# Es la única que viaja al navegador. No es un secreto.
SUPABASE_ANON_KEY=

# Clave de SERVICIO. En el panel: "service_role secret" o
# "Secret keys". Saltea las políticas RLS.
# >>> SECRETA. Sólo backend. Nunca al navegador ni al repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto con el que Supabase firma los JWT, para que el backend
# pueda verificar las sesiones.
# Panel → Project Settings → API Keys → JWT Keys → "Legacy JWT
# Secret" (o "JWT Settings" según la versión del panel).
# >>> SECRETO. Sólo backend.
SUPABASE_JWT_SECRET=


# ------------------------------------------------------------
#  APLICACIÓN
# ------------------------------------------------------------
# development | preview | production
# No cambia el esquema (siempre es 'public'). Para migrar sí hay que
# pasar APP_ENV=production explícito en la línea de comando: es la
# señal consciente de que se va a tocar el único esquema real.
APP_ENV=development

APP_TIMEZONE=America/Argentina/Buenos_Aires

# Separados por coma. En el servidor queda vacío: el frontend y la
# API comparten dominio detrás del mismo proxy, así que no hay CORS.
# En local, los puertos del frontend y de la API.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Orden en que se intentan los proveedores de cotizaciones.
# El último siempre es "manual": es el camino garantizado.
PRICE_PROVIDER_ORDER=byma,public,manual

# Mínimo de minutos entre refrescos de cotizaciones por usuario.
PRICE_REFRESH_COOLDOWN_MINUTES=15

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
